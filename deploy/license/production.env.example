# Copy to an operator-owned environment file; no credentials belong here.
# Both fields must name the same real domain covered by secrets/fullchain.pem.
# The application refuses placeholders, localhost, HTTP, invalid/expired/mismatched
# certificates and a public URL/domain mismatch before opening the database.
LICENSE_PUBLIC_URL=https://REPLACE_WITH_REAL_DOMAIN
LICENSE_PUBLIC_HOST=REPLACE_WITH_REAL_DOMAIN
