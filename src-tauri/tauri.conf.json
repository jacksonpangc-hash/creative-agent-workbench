{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creative Agent",
  "version": "0.5.5",
  "identifier": "org.creativeagent.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob: https:; connect-src 'self' http://127.0.0.1:*; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/creative-worker",
      "binaries/creative-browser-host"
    ],
    "resources": {
      "../dist/": "ui/",
      "../browser-extension/": "browser-extension/"
    },
    "category": "Productivity",
    "shortDescription": "Local BYOK ecommerce creative strategy agent",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
